# Docker Compose settings (copy to .env). Local development only.
# These must match the credentials of an existing db_data volume; MySQL only
# reads them when the volume is first created.
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# URL the browser uses to reach the API.
NUXT_PUBLIC_API_BASE=http://localhost:8081
