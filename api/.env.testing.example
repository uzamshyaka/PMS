# Copy to .env.testing (git-ignored). Used only by the PHPUnit suite.
# phpunit.xml forces APP_ENV=testing, DB_CONNECTION=mysql and
# DB_DATABASE=carshowcase_test; this file supplies the rest.

APP_NAME="Car Showcase"
APP_ENV=testing
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
FRONTEND_URL=http://localhost:3000

# Running tests on the host: the compose MySQL is published on port 3307.
# Running tests inside the api container: use DB_HOST=db and DB_PORT=3306.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=carshowcase_test
DB_USERNAME=laravel
DB_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=
